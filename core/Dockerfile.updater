FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY index.js ./index.js
COPY tld-without-privacy.json ./tld-without-privacy.json
COPY docker/updater/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Shared data mount where refreshed JSON files are written.
VOLUME ["/data"]

ENV CRON_SCHEDULE=0 */6 * * *
ENV FORCE_REFRESH=1

CMD ["/entrypoint.sh"]
